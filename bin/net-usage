#!/usr/bin/bash
# net-usage — which apps used the network, in bytes.
#
# Wraps nethogs, which is the only tool on a stock Arch box that attributes
# wire bytes to a process without a kernel module. Everything messy about its
# output — a name field that contains slashes and spaces, totals printed in
# scientific notation, container traffic that has no host pid — is dealt with
# here, so the QML side only ever sees a clean table.
#
#   net-usage top [n]        one snapshot, human-readable. Run it yourself.
#   net-usage stream [secs]  long-lived TSV for the bar widget
#   net-usage validate [s]   counted-vs-kernel cross-check, reads only
#   net-usage explain [s]    what the untraceable bytes actually were
#   net-usage history        the saved history file, bounded and type-checked
#   net-usage save           replace that file with the store on stdin
#   net-usage probe          interface, date and container counters, once
#   net-usage doctor         is anything missing, and what to do about it
#
# No sudo or pkexec is required: the nethogs package grants its own binary the
# capabilities it needs at install time.

set -uo pipefail

# Every number below is read and printed in the C locale, whatever the session
# uses. nethogs prints 5.12971e+06 under every locale, and mawk under a
# comma-decimal one (pl_PL, de_DE) reads that as 5: the same capture came to
# 7.7 GB under C and to 905 KB under pl_PL, with a verdict of OK.
export LC_ALL=C

VERSION=1.2.1
NETHOGS=/usr/bin/nethogs

# The uplink also carries the whole subnet's broadcast and multicast chatter —
# mDNS, NetBIOS, SSDP. The card receives it because it is addressed to
# everyone, no socket on this machine owns a single byte of it, and the kernel
# drops it on the floor. nethogs counts it anyway and, having no process to
# charge it to, files all of it under "unknown". On a busy corporate LAN that
# is routinely most of the day's inbound total, which turns the chart into one
# enormous unnamed bar that answers nothing and alarms everyone who sees it.
# Drop it at the capture, where it costs nothing. Setting NET_USAGE_LAN_NOISE=1
# counts it again, for whoever is measuring the wire rather than the machine.
#
# Only on an Ethernet-framed link (type 1). pcap refuses an `ether` filter on any
# other kind -- a WireGuard or other tun device, PPP -- and nethogs exits on the
# refusal, so with a full-tunnel VPN as the default route, or with the tunnel
# named in the interface setting as this README advises, nothing was counted at
# all. Those links carry no broadcast chatter of this kind to drop.
NH_FILTER=()
set_filter() {
  NH_FILTER=()
  [ "${NET_USAGE_LAN_NOISE:-0}" = "1" ] && return 0
  [ "$(cat "/sys/class/net/$1/type" 2>/dev/null)" = "1" ] &&
    NH_FILTER=(-f 'not (ether multicast or ether broadcast)')
  return 0
}

# mawk reads a pipe in 4 KiB blocks unless told otherwise, so on a quiet machine
# a snapshot sat in its buffer for minutes: 95 seconds of `stream 2` produced
# nothing past the first line. gawk reads what is there, and does not know the
# option, so it is asked for only where the awk is mawk.
AWK_FLAGS=()
awk_flags() {
  AWK_FLAGS=()
  case "$(awk -W version 2>&1)" in mawk*) AWK_FLAGS=(-W interactive) ;; esac
}

# A number given on the command line, checked before it reaches arithmetic or
# another program: a whole number from $2 to $3.
whole() {
  [[ $1 =~ ^[0-9]{1,6}$ ]] && [ "$((10#$1))" -ge "$2" ] && [ "$((10#$1))" -le "$3" ]
}

# The shell this plugin runs inside is shared with the whole desktop, and
# Quickshell's FileView will hand it whatever is at a path with no ceiling on
# how much it reads. The history file sits at a predictable location in a
# directory every process running as this user can write to, so it is read
# here instead — in a child process, through one descriptor that answers for
# itself, and never more than this many bytes. 90 days of a busy machine is
# well under a megabyte.
MAX_HISTORY=$((8 * 1024 * 1024))

# Rows longer than this are refused unread. A process name is really the whole
# command line, and an Electron app's runs to 700 characters; something far
# past that is not a name we want to hold in memory, let alone draw.
MAX_LINE=4096
# And a snapshot with more rows than this is a runaway, not a busy machine.
MAX_ROWS=2000

# Those two bound one snapshot. They do not bound the accumulator, which is the
# thing the shell actually reads: it keeps a running total per program name and
# reprints all of them on every sample, so a churn of short-lived programs with
# fresh names makes each sample larger than the last, for ever. Measured before
# this ceiling existed: 500 new names per snapshot took one sample from nothing
# to 290 KB in twenty snapshots, still climbing, into the shell the whole desktop
# shares. Past this many distinct programs the rest are summed into one row, so
# the totals stay honest and the width stops growing.
MAX_APPS=512
# Cut where the name is made rather than where it is stored. The QML side cuts to
# the same length; doing it here means the bytes never travel at all.
MAX_NAME=128
# The per-process-instance totals are what deltas are measured against, so they
# cannot simply be dropped. Past this many the accumulator stands down instead
# and the caller starts a fresh one, which is the same rebase the day turning
# already performs.
MAX_KEYS=8000

die() { printf 'net-usage: %s\n' "$*" >&2; exit 1; }

# The interface carrying the default route. Monitoring every interface instead
# double-counts: traffic from a container is seen once on the bridge and again
# on the uplink, which reported a measured 3 MB download as 6.24 MB.
default_iface() {
  # An explicitly named interface wins: with a tunnel up, the same payload is
  # visible as plaintext inside it and as encrypted UDP outside it, and only
  # the person running it knows which of the two they meant to count.
  if [ -n "${NET_USAGE_IFACE:-}" ]; then
    printf '%s\n' "$NET_USAGE_IFACE"; return 0
  fi
  # IPv4 first, then IPv6: a network with only an IPv6 default route used to read
  # as no route at all.
  local dev
  dev=$(ip route show default 2>/dev/null | awk '/^default/ {
    for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }
  }')
  [ -n "$dev" ] || dev=$(ip -6 route show default 2>/dev/null | awk '/^default/ {
    for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }
  }')
  [ -n "$dev" ] && printf '%s\n' "$dev"
  return 0
}

# Container traffic never carries a host pid — the socket lives in another
# network namespace, so nethogs files it under "unknown TCP". But
# /proc/<pid>/net/dev is namespace-aware and world-readable, so reading it
# through any process inside the container gives that container's own byte
# counters exactly, with no privileges and no docker stats rounding.
containers() {
  [ "${NET_USAGE_CONTAINERS:-1}" = "1" ] || return 0
  command -v docker >/dev/null 2>&1 || return 0

  local ids name pid mode rx tx
  ids=$(timeout -k 1 2 docker ps -q 2>/dev/null | head -c 65536) || return 0
  [ -n "$ids" ] || return 0

  # One call for every container. A wedged daemon costs one lookup and a
  # skipped refresh, never a hung widget.
  #
  # A container that shares a network namespace it does not own -- the host's
  # (--network host) or another container's -- reports those counters, not its
  # own: the host's are already the process rows, and the other container's are
  # its own row. Counting them again put a second copy of the whole machine's
  # traffic on top of the first. Only a namespace of its own is a container's.
  #
  # The name is read and printed here and goes on no command line: the awk below
  # is handed only the pid's own file.
  # shellcheck disable=SC2086 # the ids are words, one per container
  timeout -k 1 2 docker inspect --format '{{.Name}}|{{.State.Pid}}|{{.HostConfig.NetworkMode}}' $ids 2>/dev/null |
  head -c 1048576 |
  while IFS='|' read -r name pid mode; do
    name=${name#/}; name=${name//[$'\t\n\r']/ }
    [ -n "$name" ] && [[ $pid =~ ^[1-9][0-9]{0,9}$ ]] || continue
    case $mode in host|none|container:*) continue ;; esac
    [ -r "/proc/$pid/net/dev" ] || continue
    read -r rx tx < <(awk 'NR > 2 { i = $1; sub(/:$/, "", i); if (i != "lo") { r += $2; t += $10 } }
                           END { printf "%.0f %.0f\n", r + 0, t + 0 }' "/proc/$pid/net/dev" 2>/dev/null) || continue
    printf 'ctr\t%s\t%s\t%s\n' "$name" "${rx:-0}" "${tx:-0}"
  done
}

probe() {
  printf 'iface\t%s\n' "$(default_iface)"
  printf 'day\t%s\n' "$(date +%F)"
  containers
}

doctor() {
  local ok=0
  if [ -x "$NETHOGS" ]; then
    printf 'nethogs\tfound\t%s\n' "$NETHOGS"
  else
    printf 'nethogs\tmissing\t%s\n' "$NETHOGS"; ok=1
  fi

  # The package sets these itself on install. Without them nethogs cannot open
  # a capture socket and exits immediately, which reads to a user as "the
  # plugin is broken" rather than "this one binary lost its capabilities".
  if command -v getcap >/dev/null 2>&1 && [ -x "$NETHOGS" ]; then
    local caps; caps=$(getcap "$NETHOGS" 2>/dev/null)
    case "$caps" in
      *cap_net_raw*) printf 'caps\tok\t%s\n' "${caps#* }" ;;
      *) printf 'caps\tmissing\treinstall the nethogs package to restore them\n'; ok=1 ;;
    esac
  fi

  local i; i=$(default_iface)
  [ -n "$i" ] && printf 'iface\tok\t%s\n' "$i" || { printf 'iface\tnone\tno default route\n'; ok=1; }

  if command -v docker >/dev/null 2>&1; then
    if timeout -k 1 2 docker ps -q >/dev/null 2>&1; then
      printf 'docker\tok\tcontainer traffic will be named\n'
    else
      printf 'docker\tunreachable\tcontainer traffic stays in the unattributed row\n'
    fi
  else
    printf 'docker\tabsent\tnothing to name\n'
  fi
  return $ok
}

# The accumulator. nethogs reports a running total per pid; pids come and go,
# and a pid that dies is dropped from later snapshots, so summing the visible
# rows would make an app's total fall. We therefore add per-pid deltas into a
# per-app running total that only ever grows, and hand that to the caller.
read -r -d '' ACCUMULATE <<'AWK'
function appname(nm, pid,   parts, k, first, path, line, toks, nt, i, last) {
  # Chromium and every Electron app report their whole command line as the
  # name. The binary is the first token; the rest is argv and is noise here.
  first = nm
  k = index(first, " ")
  if (k > 0 && substr(first, 1, 1) == "/") {
    # Unless the binary's own path has a space in it. "/opt/Google Chrome/chrome
    # --type=renderer" is one path and one option, and the first word alone named
    # every Chrome process "Google". An absolute path runs on through the words
    # after it up to the last that still holds a slash, and stops at the first
    # word that is an option or another absolute path.
    nt = split(first, toks, " ")
    last = 1
    for (i = 2; i <= nt; i++) {
      if (toks[i] ~ /^[-\/]/) break
      if (index(toks[i], "/") > 0) last = i
    }
    first = toks[1]
    for (i = 2; i <= last; i++) first = first " " toks[i]
  } else if (k > 0) first = substr(first, 1, k - 1)
  # nethogs prints "curl" or "/usr/bin/curl" for the same binary depending on
  # whether it managed to read /proc in time. Both must land in one row.
  k = split(first, parts, "/")
  first = (parts[k] != "" ? parts[k] : first)

  # And sometimes it hands back the /proc/<pid>/exe path itself rather than
  # what the link points at, which reduces to a meaningless "exe". comm is
  # world-readable even for another user's process, so ask it directly.
  if (first == "exe" || first == "" || first ~ /^[0-9]+$/) {
    path = "/proc/" pid "/comm"
    line = ""
    if ((getline line < path) > 0 && line != "") first = line
    close(path)
  }
  return substr(first, 1, MAX_NAME)
}

# nethogs reports what it could not place as two rows of its own, "unknown TCP"
# and "unknown UDP", and the distinction is worth keeping. TCP that nobody owns
# is almost always a container's traffic crossing the NAT; UDP that nobody owns
# is almost always chatter the card received and the kernel dropped.
function unknownBucket(nm) {
  return (nm ~ /UDP/) ? UNK_UDP : UNK_TCP
}

# Seconds since boot, or -1. Read from the file rather than asked of a program:
# this runs once per snapshot boundary.
function uptime(   l, u, t) {
  t = -1; l = ""
  if ((getline l < "/proc/uptime") > 0) { split(l, u, " "); t = u[1] + 0 }
  close("/proc/uptime")
  return t
}

# A plain decimal, as nethogs prints one: no sign, no hex, no inf or nan, all of
# which mawk would otherwise read as numbers.
function isnum(s) { return s ~ /^[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?$/ }

function refresh(   cmd, line, f, n, nm, i, gone) {
  # One helper call answers three questions: has the default route moved, has
  # the day rolled over, and what have the containers transferred.
  #
  # A fixed string, in a variable. The helper's path reaches the shell that
  # getline starts through the environment (NU_HELPER), so nothing is spliced
  # into a command: a plugin folder with a space in it ran a program named by
  # its first word. And a variable rather than an expression left of `|`, which
  # POSIX awk leaves ambiguous: mawk read HELPER " probe" | getline as
  # HELPER (" probe" | getline), ran a command called "probe", then compared the
  # string HELPER "0" with 0, which is true, so the loop never ended. The probe
  # has a deadline of its own, so a docker daemon that never answers costs a
  # skipped refresh rather than a stalled stream.
  cmd = "exec timeout -k 1 10 \"$NU_HELPER\" probe 2>/dev/null"
  # Element-wise: `delete array` without a subscript is a gawk extension
  # that mawk rejects, and this same program runs under the CI runner's awk.
  for (nm in ctrSeen) delete ctrSeen[nm]
  while ((cmd | getline line) > 0) {
    n = split(line, f, "\t")
    if (n >= 2 && f[1] == "iface") { curIface = f[2]; continue }
    if (n >= 2 && f[1] == "day")   { curDay = f[2];   continue }
    if (n >= 4 && f[1] == "ctr" && isnum(f[3]) && isnum(f[4])) {
      nm = substr(f[2], 1, MAX_NAME)
      if (!(nm in ctrBaseRx)) { ctrBaseRx[nm] = f[3] + 0; ctrBaseTx[nm] = f[4] + 0 }
      # A container that restarts resets its counters; rebase rather than
      # subtract a larger number from a smaller one. What it had counted before
      # stays carved out of the unknown row below: those bytes went into that
      # row once, and handing them back would count them a second time.
      if (f[3] + 0 < ctrBaseRx[nm]) { goneRx += ctrRx[nm]; ctrBaseRx[nm] = f[3] + 0 }
      if (f[4] + 0 < ctrBaseTx[nm]) { goneTx += ctrTx[nm]; ctrBaseTx[nm] = f[4] + 0 }
      ctrRx[nm] = f[3] + 0 - ctrBaseRx[nm]
      ctrTx[nm] = f[4] + 0 - ctrBaseTx[nm]
      ctrSeen[nm] = 1
    }
  }
  close(cmd)

  # A container that is gone takes its baseline with it. Keeping them is what
  # turns a churn of short-lived containers into a map that only ever grows.
  # Its bytes stay carved out of the unknown row, for the same reason as above.
  n = 0
  for (nm in ctrBaseRx) if (!(nm in ctrSeen)) gone[++n] = nm
  for (i = 1; i <= n; i++) {
    goneRx += ctrRx[gone[i]]; goneTx += ctrTx[gone[i]]
    delete ctrBaseRx[gone[i]]; delete ctrBaseTx[gone[i]]
    delete ctrRx[gone[i]];     delete ctrTx[gone[i]]
    delete gone[i]
  }
}

function kers(   p, line, rest, nf, f, i, j, vals, rx, tx) {
  # Per-snapshot kernel counters for the monitored interface, read straight
  # from the file with getline: no fork per snapshot, and zeros when the
  # interface is absent or the file unreadable. Old readers ignore the line.
  p = (PROCDEV != "" ? PROCDEV : "/proc/net/dev")
  rx = 0; tx = 0
  while ((getline line < p) > 0) {
    sub(/^[ \t]+/, "", line)
    if (index(line, IFACE ":") == 1) {
      rest = substr(line, length(IFACE) + 2)
      nf = split(rest, f, /[ \t]+/)
      j = 0
      for (i = 1; i <= nf; i++) if (f[i] != "") vals[++j] = f[i]
      if (j >= 9) { rx = vals[1] + 0; tx = vals[9] + 0 }
    }
  }
  close(p)
  printf "kers\t%s\t%.0f\t%.0f\n", IFACE, rx, tx
}

function emit(   a, cUp, cDown, tUp, tDown, uUp, uDown, d) {
  printf "snap\t%s\n", curDay
  kers()

  cUp = goneTx; cDown = goneRx
  for (a in ctrSeen) { cUp += ctrTx[a]; cDown += ctrRx[a] }

  for (a in accUp) {
    if (a == UNK_TCP || a == UNK_UDP) continue
    printf "row\t%.0f\t%.0f\tproc\t%s\n", accUp[a], accDown[a], a
  }
  for (a in ctrSeen)
    printf "row\t%.0f\t%.0f\tcontainer\t%s\n", ctrTx[a], ctrRx[a], a

  # Container bytes cross the uplink NAT'd, with no socket on this side of the
  # namespace, so nethogs has already counted every one of them once under
  # "unknown TCP". Naming the container above and leaving that bucket alone
  # would report the same traffic twice. Take it back out of TCP, and spill
  # into UDP only for the container that spoke QUIC.
  tUp = accUp[UNK_TCP]; tDown = accDown[UNK_TCP]
  uUp = accUp[UNK_UDP]; uDown = accDown[UNK_UDP]

  d = (cUp   < tUp)   ? cUp   : tUp;   tUp   -= d; cUp   -= d
  d = (cDown < tDown) ? cDown : tDown; tDown -= d; cDown -= d
  uUp   -= cUp;   if (uUp < 0)   uUp = 0
  uDown -= cDown; if (uDown < 0) uDown = 0

  # Never a running total lower than one already printed. The container
  # counters above are refreshed every PROBE_EVERY snapshots and the unknown
  # rows every snapshot, so the remainder rose and fell between probes, and the
  # reader takes a total that fell for a fresh count and adds the next rise
  # again: steady container traffic was recorded 1.8 times over. Held at its
  # high-water mark, the remainder is late by at most a few snapshots instead.
  if (tUp   < hwTU) tUp   = hwTU; else hwTU = tUp
  if (tDown < hwTD) tDown = hwTD; else hwTD = tDown
  if (uUp   < hwUU) uUp   = hwUU; else hwUU = uUp
  if (uDown < hwUD) uDown = hwUD; else hwUD = uDown

  if (tUp > 0 || tDown > 0)
    printf "row\t%.0f\t%.0f\tunattributed\t%s\n", tUp, tDown, UNK_TCP
  if (uUp > 0 || uDown > 0)
    printf "row\t%.0f\t%.0f\tunattributed\t%s\n", uUp, uDown, UNK_UDP

  print "end"
  fflush()
}

BEGIN {
  rows = 0; sinceProbe = PROBE_EVERY; curDay = ""; curIface = IFACE
  nApps = 0; nKeys = 0; OTHER = "(other apps)"
  UNK_TCP = "(unknown TCP)"; UNK_UDP = "(unknown UDP)"
}

# A snapshot boundary. Everything gathered since the last one is now complete.
/^Refreshing:/ {
  # nethogs prints one of these every -d seconds, and it also prints every
  # process's command line verbatim, newlines and all, so any local account can
  # put this same line on our input. One process doing so produced 24,006
  # boundaries in eight seconds and a probe fork for every fifth. A boundary
  # sooner than MINGAP seconds after the last is not one. MINGAP=0 turns this
  # off, for a capture replayed from a file.
  if (MINGAP + 0 > 0) {
    now = uptime()
    if (now >= 0 && lastB >= 0 && now - lastB < MINGAP + 0) next
    lastB = now
  }
  if (++sinceProbe >= PROBE_EVERY) { refresh(); sinceProbe = 0 }
  # The route moving or the day turning both invalidate this nethogs process:
  # it enumerated its interfaces once at startup and its counters are bound to
  # the old day. Exiting drops the pipe, and the caller starts a fresh one.
  if (curIface != "" && curIface != IFACE) {
    printf "note\trestart\troute-moved\n"; fflush(); exit 0
  }
  if (startDay == "") startDay = curDay
  if (curDay != "" && curDay != startDay) {
    printf "note\trestart\tday-rolled\n"; fflush(); exit 0
  }
  if (nKeys > MAX_KEYS) {
    printf "note\trestart\tkey-ceiling\n"; fflush(); exit 0
  }
  if (started) emit()
  started = 1
  rows = 0
  # Who was in the snapshot that just ended. See the rows below.
  for (k in seenPrev) delete seenPrev[k]
  for (k in seenNow) { seenPrev[k] = 1; delete seenNow[k] }
  next
}

length($0) > MAX_LINE { next }

{
  if (++rows > MAX_ROWS) next
  # Read from the right. The name is a process's own command line, which any
  # process may fill with tabs; the last two fields are the only part nethogs
  # writes itself. A tab in a name used to fail the field count, and that
  # process's traffic, 5.6 GB in one test, was dropped without a word.
  nf = split($0, F, "\t")
  if (nf < 3) next                            # every banner and notice fails here
  if (!isnum(F[nf - 1]) || !isnum(F[nf])) next
  head = F[1]
  for (i = 2; i <= nf - 2; i++) head = head "\t" F[i]

  m = split(head, S, "/")
  if (m < 3) next
  uid = S[m]; pid = S[m - 1]
  if (pid !~ /^[0-9]+$/ || uid !~ /^[0-9]+$/) next
  name = S[1]
  for (i = 2; i <= m - 2; i++) name = name "/" S[i]

  # Printed at six significant digits, so anything past a megabyte arrives as
  # 5.12971e+06. awk widens it correctly; parseInt would read it as 5.
  up = F[nf - 1] + 0; down = F[nf] + 0
  if (up > 1e15 || down > 1e15) next          # a petabyte per process is not a measurement

  key = head
  # Membership before the reads below: merely naming lastUp[key] in an
  # expression creates the element, so testing afterwards is always false and
  # the key ceiling would never stand the accumulator down.
  if (!(key in lastUp)) nKeys++
  # nethogs prints every process it holds on every refresh, idle or not, and
  # forgets one that has been quiet for a while; when it speaks again its total
  # starts from zero. So a key missing from the snapshot before this one is a
  # fresh count, and all of it is new. Subtracting the old total from it lost
  # that much traffic whenever the new total had grown past the old one.
  if ((key in seenPrev) || (key in seenNow)) {
    du = up - lastUp[key];     if (du < 0) du = up
    dd = down - lastDown[key]; if (dd < 0) dd = down
  } else {
    du = up; dd = down
  }
  seenNow[key] = 1
  lastUp[key] = up; lastDown[key] = down

  a = (pid + 0 == 0) ? unknownBucket(name) : appname(name, pid)
  # Past the ceiling the bytes are still counted, just not under a name of their
  # own. Dropping them instead would make the totals quietly wrong, which is a
  # worse answer than one honest row saying the rest were too many to draw.
  if (!(a in accUp)) {
    if (nApps >= MAX_APPS) a = OTHER
    else nApps++
  }
  accUp[a] += du; accDown[a] += dd
}

END { if (started) emit() }
AWK

SELF="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"

# MINGAP is half the interval, in seconds: see the boundary rule in ACCUMULATE.
run_accumulator() {
  local iface=$1 interval=$2 probe_every=$3
  awk_flags
  "$NETHOGS" -t -C -v 2 -d "$interval" "${NH_FILTER[@]}" -- "$iface" 2>/dev/null |
    NU_HELPER="$SELF" awk "${AWK_FLAGS[@]}" -v MINGAP="$((interval * 500))e-3" \
        -v IFACE="$iface" -v PROBE_EVERY="$probe_every" \
        -v PROCDEV="${NET_USAGE_PROC_DEV:-/proc/net/dev}" \
        -v MAX_LINE="$MAX_LINE" -v MAX_ROWS="$MAX_ROWS" \
        -v MAX_APPS="$MAX_APPS" -v MAX_NAME="$MAX_NAME" -v MAX_KEYS="$MAX_KEYS" \
        -- "$ACCUMULATE"
}

# True when this process leads its own process group. Read from /proc rather
# than asked of ps; the command name in that line may hold spaces, so the
# fields are counted from the parenthesis that closes it.
own_group() {
  local stat pgrp
  stat=$(< "/proc/$$/stat") || return 1
  stat=${stat##*) }
  read -r _ _ pgrp _ <<<"$stat"
  [ "$pgrp" = "$$" ]
}

# A sleep that a signal ends. bash runs a trap only once the foreground command
# it is waiting on has finished; `wait` is the one it interrupts.
nap() { sleep "$1" & wait $!; }

# Long-lived. Restarts nethogs when the accumulator stands down, which it does
# when the default route moves or the day turns — nethogs enumerates its
# interfaces exactly once at startup, so a Wi-Fi association or a tunnel coming
# up after it started is invisible to it for the rest of its life.
#
# It runs in a process group of its own and takes the whole group down on TERM.
# Quickshell stops a Process by signalling the one pid it started, and nethogs
# and awk used to outlive it, reparented, until their next write found the pipe
# closed. setsid can make a new group without forking only for a process that
# does not lead one already; a terminal's job does, and keeps its own.
stream() {
  local interval=${1:-2} iface fails=0 t0
  whole "$interval" 1 10 || die "the interval is a whole number of seconds, 1 to 10"
  interval=$((10#$interval))
  [ -x "$NETHOGS" ] || die "nethogs is not installed at $NETHOGS"
  if ! own_group && command -v setsid >/dev/null 2>&1; then
    exec setsid "$SELF" stream "$interval"
  fi
  trap 'trap - TERM INT; kill -TERM 0 2>/dev/null' TERM INT
  while :; do
    iface=$(default_iface)
    if [ -z "$iface" ]; then
      printf 'wait\tno default route\n'; nap 5; continue
    fi
    set_filter "$iface"
    printf 'ready\t%s\t%s\n' "$iface" "$interval"
    t0=$SECONDS
    run_accumulator "$iface" "$interval" 5 &
    wait $!
    # nethogs that stops within seconds of starting will stop again: it has no
    # capture capability, or pcap refused the interface. Restarting it every two
    # seconds said `ready` every two seconds, which read to the panel as a
    # collector that was working. Say what happened, and back off.
    if [ $((SECONDS - t0)) -lt 5 ]; then
      fails=$((fails + 1))
      printf 'wait\tnethogs stopped right after starting\n'
      nap $((fails < 6 ? 5 * fails : 30))
    else
      fails=0
      nap 2
    fi
  done
}

human() {
  awk -v b="$1" 'BEGIN {
    split("B KB MB GB TB", u, " "); i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    printf (i == 1 ? "%.0f %s" : "%.1f %s"), b, u[i]
  }'
}

# The hand-runnable view. Watches for a few seconds and prints what moved.
top() {
  local n=${1:-10} secs=${2:-6} iface
  whole "$n" 1 1000 || die "the row count is a whole number, 1 to 1000"
  whole "$secs" 1 3600 || die "the window is a whole number of seconds, 1 to 3600"
  n=$((10#$n)); secs=$((10#$secs))
  [ -x "$NETHOGS" ] || die "nethogs is not installed at $NETHOGS"
  iface=$(default_iface) || true
  [ -n "$iface" ] || die "no default route: nothing to watch"
  set_filter "$iface"

  printf 'Watching %s for %ss...\n\n' "$iface" "$secs"
  local rows
  rows=$(timeout -k 1 "$((secs + 2))" "$NETHOGS" -t -C -v 2 -d 1 "${NH_FILTER[@]}" -- "$iface" 2>/dev/null |
    NU_HELPER="$SELF" awk -v MINGAP=0.5 -v IFACE="$iface" -v PROBE_EVERY=3 \
        -v MAX_LINE="$MAX_LINE" -v MAX_ROWS="$MAX_ROWS" \
        -v MAX_APPS="$MAX_APPS" -v MAX_NAME="$MAX_NAME" -v MAX_KEYS="$MAX_KEYS" \
        -- "$ACCUMULATE" |
    awk '/^snap/ { buf = "" } /^row/ { buf = buf $0 "\n" } END { printf "%s", buf }')

  [ -n "$rows" ] || { printf 'Nothing moved.\n'; return 0; }

  printf '%-24s %12s %12s  %s\n' "APP" "DOWN" "UP" "SOURCE"
  printf '%s\n' "$rows" |
    sort -t"$(printf '\t')" -k3,3nr |
    head -n "$n" |
    while IFS="$(printf '\t')" read -r _ up down kind name; do
      printf '%-24.24s %12s %12s  %s\n' \
        "$name" "$(human "$down")" "$(human "$up")" "$kind"
    done
}

# Kernel counters for one interface out of a /proc/net/dev snapshot: "rx tx",
# or "0 0" when the interface is absent or the file unreadable.
proc_dev_counters() {
  awk -v want="$2" '
    {
      line = $0; sub(/^[ \t]+/, "", line)
      if (index(line, want ":") == 1) {
        rest = substr(line, length(want) + 2)
        n = split(rest, f, /[ \t]+/); j = 0
        for (i = 1; i <= n; i++) if (f[i] != "") v[++j] = f[i]
        if (j >= 9) { printf "%.0f %.0f", v[1] + 0, v[9] + 0; found = 1 }
      }
    }
    END { if (!found) printf "0 0" }' "$1" 2>/dev/null || printf '0 0'
}

# First non-loopback interface named in a /proc/net/dev snapshot. Fixture-mode
# fallback only, so a hand-made fixture needs no live route and no iface file.
iface_from_proc() {
  awk '
    { line = $0; sub(/^[ \t]+/, "", line) }
    index(line, ":") > 0 {
      name = substr(line, 1, index(line, ":") - 1)
      if (name != "" && name != "lo" && name !~ /^Inter/) { print name; exit }
    }' "$1" 2>/dev/null
}

# The cross-check. Runs the same accumulator as top() over the same capture,
# then reads the kernel's own byte counters for the monitored interface before
# and after and asks whether the two agree. They should: nethogs watches the
# same wire the kernel counts, plus a few percent of headers. A counted total
# several times the wire means the attribution is wrong, not the traffic — the
# usual suspect is a churn of short-lived processes landing in the unknown
# bucket with deltas miscounted across accumulator restarts. Reads only;
# history.json is never touched.
#
# Fixture mode: with NET_USAGE_FIXTURE_DIR set, the capture comes from
# $dir/stream.txt and the kernel counters from $dir/proc_before and
# $dir/proc_after (full /proc/net/dev text, plus an optional $dir/iface
# naming the interface), so the verdict is deterministic.
validate() {
  local secs=${1:-5} iface fixdir="${NET_USAGE_FIXTURE_DIR:-}"
  local kbefore kafter rows helper
  local brx btx arx atx kup kdown cup cdown ctot ktot ratio
  whole "$secs" 1 3600 || die "the window is a whole number of seconds, 1 to 3600"
  secs=$((10#$secs))

  if [ -n "$fixdir" ]; then
    [ -f "$fixdir/stream.txt" ] || die "fixture $fixdir/stream.txt is missing"
    [ -f "$fixdir/proc_before" ] || die "fixture $fixdir/proc_before is missing"
    [ -f "$fixdir/proc_after" ] || die "fixture $fixdir/proc_after is missing"
    if [ -f "$fixdir/iface" ]; then
      iface=$(head -n 1 "$fixdir/iface")
    elif [ -n "${NET_USAGE_IFACE:-}" ]; then
      iface=$NET_USAGE_IFACE
    else
      iface=$(default_iface) || true
      [ -n "$iface" ] || iface=$(iface_from_proc "$fixdir/proc_before")
    fi
    [ -n "$iface" ] || die "no interface: put one in $fixdir/iface"
    # No live helpers in fixture mode: the probe would answer with today's
    # date and the live route, and per-snapshot kernel reads have no fixture
    # counterpart (downstream only keeps the row lines anyway).
    helper=true
  else
    [ -x "$NETHOGS" ] || die "nethogs is not installed at $NETHOGS"
    iface=$(default_iface) || true
    [ -n "$iface" ] || die "no default route: nothing to watch"
    set_filter "$iface"
    helper=$SELF
  fi

  printf 'Validating %s for %ss (counted vs kernel)...\n\n' "$iface" "$secs"

  if [ -n "$fixdir" ]; then
    kbefore=$(proc_dev_counters "$fixdir/proc_before" "$iface")
    rows=$(NU_HELPER="$helper" awk -v MINGAP=0 -v IFACE="$iface" -v PROBE_EVERY=3 \
        -v PROCDEV=/dev/null \
        -v MAX_LINE="$MAX_LINE" -v MAX_ROWS="$MAX_ROWS" \
        -v MAX_APPS="$MAX_APPS" -v MAX_NAME="$MAX_NAME" -v MAX_KEYS="$MAX_KEYS" \
        -- "$ACCUMULATE" < "$fixdir/stream.txt" |
      awk '/^snap/ { buf = "" } /^row/ { buf = buf $0 "\n" } END { printf "%s", buf }')
    kafter=$(proc_dev_counters "$fixdir/proc_after" "$iface")
  else
    kbefore=$(proc_dev_counters /proc/net/dev "$iface")
    rows=$(timeout -k 1 "$((secs + 2))" "$NETHOGS" -t -C -v 2 -d 1 "${NH_FILTER[@]}" -- "$iface" 2>/dev/null |
      NU_HELPER="$helper" awk -v MINGAP=0.5 -v IFACE="$iface" -v PROBE_EVERY=3 \
          -v PROCDEV="${NET_USAGE_PROC_DEV:-/proc/net/dev}" \
          -v MAX_LINE="$MAX_LINE" -v MAX_ROWS="$MAX_ROWS" \
          -v MAX_APPS="$MAX_APPS" -v MAX_NAME="$MAX_NAME" -v MAX_KEYS="$MAX_KEYS" \
          -- "$ACCUMULATE" |
      awk '/^snap/ { buf = "" } /^row/ { buf = buf $0 "\n" } END { printf "%s", buf }')
    kafter=$(proc_dev_counters /proc/net/dev "$iface")
  fi

  if [ -n "$rows" ]; then
    printf '%-24s %12s %12s  %s\n' "APP" "DOWN" "UP" "SOURCE"
    printf '%s\n' "$rows" |
      sort -t"$(printf '\t')" -k3,3nr |
      while IFS="$(printf '\t')" read -r _ up down kind name; do
        printf '%-24.24s %12s %12s  %s\n' \
          "$name" "$(human "$down")" "$(human "$up")" "$kind"
      done
  else
    printf 'Nothing moved.\n'
  fi
  printf '\n'

  read -r brx btx <<<"$kbefore"
  read -r arx atx <<<"$kafter"
  kdown=$((arx - brx)); kup=$((atx - btx))
  # A counter that went backwards wrapped or reset; take the later reading.
  if [ "$kdown" -lt 0 ]; then kdown=$arx; fi
  if [ "$kup" -lt 0 ]; then kup=$atx; fi
  cup=$(printf '%s\n' "$rows" | awk -F'\t' '{ u += $2 } END { printf "%.0f", u + 0 }')
  cdown=$(printf '%s\n' "$rows" | awk -F'\t' '{ d += $3 } END { printf "%.0f", d + 0 }')
  ctot=$((cup + cdown)); ktot=$((kdown + kup))

  printf 'KERNEL %s down %s up %s\n' "$iface" "$(human "$kdown")" "$(human "$kup")"
  if [ "$ktot" -le 0 ]; then
    printf 'RATIO n/a (no wire traffic in the window)\n'
    printf 'VERDICT INSUFFICIENT-DATA — rerun while traffic flows.\n'
    return 0
  fi
  ratio=$(awk -v c="$ctot" -v k="$ktot" 'BEGIN { printf "%.2f", c / k }')
  printf 'RATIO %s (counted %s / kernel %s)\n' \
    "$ratio" "$(human "$ctot")" "$(human "$ktot")"
  if awk -v r="$ratio" 'BEGIN { exit !(r <= 1.5) }'; then
    printf 'VERDICT OK — counted bytes track the wire.\n'
  elif awk -v r="$ratio" 'BEGIN { exit !(r <= 2.5) }'; then
    printf 'VERDICT SUSPECT — counted %sx the wire; watch the unknown bucket.\n' "$ratio"
  else
    printf 'VERDICT OVERSHOOT — counted %sx the wire. Likely unknown-bucket churn: a storm of short-lived build workers (e.g. npm run build) landing in (unknown TCP) with deltas miscounted across accumulator restarts. Grep `note\trestart` in `net-usage stream` output for the restarts.\n' "$ratio"
  fi
  return 0
}

# The chart can say how many bytes it failed to trace to an app. It cannot say
# what they were: nethogs knows nothing about a packet beyond which socket, if
# any, owns it. This does. It re-runs the capture behind a series of pcap
# filters and reports how the traffic divides up, which is almost always enough
# to recognise an untraceable lump on sight. Slow by nature — every filter
# needs a capture window of its own.
bytes_matching() {
  local iface=$1 secs=$2 filt=$3
  # Two refreshes: the first arrives empty because nethogs has nothing to
  # report yet, the second carries the window's running total per row.
  timeout -k 1 "$((secs * 2 + 4))" \
    "$NETHOGS" -t -C -v 2 -d "$secs" -c 2 -f "$filt" -- "$iface" 2>/dev/null |
    awk -F'\t' 'NF == 3 { d[$1] = $3 + 0 }
                END { s = 0; for (k in d) s += d[k]; printf "%.0f\n", s }'
}

explain() {
  local secs=${1:-4} iface total got pct i
  whole "$secs" 1 600 || die "the window is a whole number of seconds, 1 to 600"
  secs=$((10#$secs))
  [ -x "$NETHOGS" ] || die "nethogs is not installed at $NETHOGS"
  iface=$(default_iface) || true
  [ -n "$iface" ] || die "no default route: nothing to watch"

  local labels=(
    "everything"
    "not addressed to this host"
    "  mDNS / Bonjour (5353)"
    "  NetBIOS (137, 138)"
    "  SSDP / UPnP (1900)"
    "QUIC (udp 443)"
  )
  local filters=(
    "ip or ip6"
    "ether multicast or ether broadcast"
    "udp port 5353"
    "udp port 137 or udp port 138"
    "udp port 1900"
    "udp port 443"
  )

  # A global, not a local: the trap outlives the function that sets it, and
  # under `set -u` a dead local would abort the cleanup it was written to do.
  NH_TMP=$(mktemp -d) || die "cannot create a temporary directory"
  # The cleanup on EXIT alone, and a signal turned into an exit. A trap on TERM
  # that only removed the folder let the run go on to print a table of zeros
  # and exit 0, with six captures still running behind it.
  trap 'rm -rf "${NH_TMP:-}"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  printf 'Sampling %s behind %d filters at once, for %ss.\n\n' \
    "$iface" "${#filters[@]}" "$((secs * 2))"

  # All of them share one window. Run one after another and each measures a
  # different few seconds of a machine whose traffic comes in bursts, so a
  # subset can out-measure the set it belongs to and the shares stop adding up.
  for i in "${!filters[@]}"; do
    bytes_matching "$iface" "$secs" "${filters[$i]}" > "$NH_TMP/$i" &
  done
  wait

  total=$(cat "$NH_TMP/0" 2>/dev/null)
  printf '%-30s %12s %6s\n' "ARRIVING ON THE WIRE" "DOWN" "SHARE"
  for i in "${!filters[@]}"; do
    got=$(cat "$NH_TMP/$i" 2>/dev/null)
    pct=$(awk -v g="${got:-0}" -v t="${total:-0}" \
      'BEGIN { printf "%d", (t > 0 ? 100 * g / t : 0) }')
    printf '%-30s %12s %5s%%\n' "${labels[$i]}" "$(human "${got:-0}")" "$pct"
  done

  printf '\n'
  if [ "${NET_USAGE_LAN_NOISE:-0}" = "1" ]; then
    printf 'The chart is counting the rows nothing on this machine asked for,\n'
    printf 'so they will keep arriving as one large unnamed bar.\n'
  else
    printf 'The chart leaves out what was not addressed to this host: no socket\n'
    printf 'owns those bytes, so they can never carry an app name.\n'
  fi
}

history_path() {
  printf '%s/.local/state/omarchy/network-usage/history.json' "${HOME:-}"
}

# One open, and every question after it asked of the descriptor rather than of
# the name. Testing the path first and opening it second cannot be made safe: a
# FIFO put at the name in that window swallows the read inside open(2), where
# there is no descriptor yet to inspect and no timeout around the reader can
# help — five reads in two hundred hung that way under a swap storm here. So the
# flags refuse at the open itself. O_NOFOLLOW declines a symlink at the last
# component instead of resolving it, O_NONBLOCK hands back a descriptor for a
# FIFO immediately instead of waiting on a writer, and fstat on that same
# descriptor settles type, owner and size. Whatever is put at the path
# afterwards is a different file, and this one is already open.
#
# An oversized file is refused whole rather than truncated to the ceiling: half
# a JSON document is not a shorter history, it is a parse error that arrives
# looking like no history at all. But refusing whole prints nothing, and nothing
# is also what an ordinary first run prints, so the two are told apart by the
# exit status instead: 3 means there is something at that path and it is not a
# history we will read. The caller keeps it aside rather than writing over it.
#
# perl, because the shell has no way to pass open flags, and because omarchy
# depends on it already.
history_read() {
  [ -n "${HOME:-}" ] || return 0
  command -v perl >/dev/null 2>&1 || {
    printf 'net-usage: perl is missing, so history cannot be read safely\n' >&2
    return 0
  }

  perl -- - "$(history_path)" "$MAX_HISTORY" <<'PERL'
use strict;
use warnings;
use Fcntl qw(O_RDONLY O_NOFOLLOW O_NONBLOCK);
use Errno qw(EINTR ENOENT);

my ($path, $max) = @ARGV;

# ELOOP here is a symlink at the last component, which is a refusal and not an
# absence; only ENOENT means there is genuinely nothing to read.
sysopen(my $fh, $path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK)
  or exit($! == ENOENT ? 0 : 3);

my @st = stat($fh) or exit 3;
my ($mode, $nlink, $uid, $size) = @st[2, 3, 4, 7];

exit 3 unless ($mode & 0170000) == 0100000;   # not a FIFO, device or directory
exit 3 unless $uid == $<;                     # and written by this user
exit 3 if $nlink != 1;                        # with no second name somebody else holds
exit 3 if $mode & 0022;                       # and nobody else may write it
exit 3 if $size > $max;                       # refused whole, never truncated

# O_NOFOLLOW covers the last component only. The folder above is this plugin's
# own, made 0700 by the panel, so one reached through a link, or that somebody
# else could write into, is not where this history was kept.
my ($dir) = $path =~ m{^(.*)/[^/]+$};
my @dst = lstat($dir) or exit 3;
exit 3 unless ($dst[2] & 0170000) == 0040000;  # a real directory, not a link to one
exit 3 unless $dst[4] == $<;
exit 3 if $dst[2] & 0022;

binmode $fh;
binmode STDOUT;
my $left = $size;
while ($left > 0) {
  my $n = sysread($fh, my $buf, $left < 65536 ? $left : 65536);
  if (!defined $n) { next if $! == EINTR; last }
  last if $n == 0;
  print STDOUT $buf;
  $left -= $n;
}
exit 0;
PERL
}

# The other half of the same problem. Quickshell's FileView calls its write
# atomic, and it is — onto the path it resolved, which means a symlink parked at
# history.json is followed and whatever it points at is overwritten instead. That
# was measured on this version: the plugin's own store landed in an unrelated
# file, every twenty seconds, with the symlink still standing.
#
# So the store is written here as well. The temporary file is created with
# O_EXCL, which means this open makes the name or fails — there is nothing there
# for a symlink to be — and O_NOFOLLOW is the brace to that belt. Then rename(2),
# which replaces the *name*: a symlink sitting at history.json is what gets
# replaced, and what it pointed at is never opened at all.
history_write() {
  [ -n "${HOME:-}" ] || return 1
  command -v perl >/dev/null 2>&1 || {
    printf 'net-usage: perl is missing, so history cannot be written safely\n' >&2
    return 1
  }

  # The program arrives on fd 3, not on stdin: stdin is the store being written,
  # and `perl -` would eat it as source text.
  perl /dev/fd/3 "$(history_path)" "$MAX_HISTORY" 3<<'PERL'
use strict;
use warnings;
use Fcntl qw(O_WRONLY O_CREAT O_EXCL O_NOFOLLOW O_RDONLY O_DIRECTORY);
use Errno qw(EINTR);
use IO::Handle;

my ($path, $max) = @ARGV;
my ($dir) = $path =~ m{^(.*)/[^/]+$};
exit 1 unless defined $dir && length $dir;

# The temporary file is removed on every end this process can see coming: a
# signal becomes an exit, and an exit runs END. A TERM in the middle of the
# fsync used to leave .history.<pid>.<n>.tmp behind for good.
my $tmp;
END { unlink $tmp if defined $tmp }
$SIG{$_} = sub { exit 1 } for qw(TERM INT HUP PIPE XFSZ);

# Bounded here too. A store this side of the ceiling is one the reader will
# still accept next time; anything past it would be written once and refused
# forever after, which is a worse outcome than not writing it.
binmode STDIN;
my $doc = '';
while (1) {
  my $n = sysread(STDIN, my $buf, 65536);
  if (!defined $n) { next if $! == EINTR; exit 1 }
  last if $n == 0;
  $doc .= $buf;
  exit 1 if length($doc) > $max;
}
exit 1 unless length $doc;

# What a run killed outright left behind (SIGKILL is not a signal anything can
# catch): only names this writer makes, only regular files of ours, and only
# ones an hour old, which no write still in progress can own.
if (opendir(my $dh, $dir)) {
  for my $n (readdir $dh) {
    next unless $n =~ /^\.history\.[0-9a-f.]+\.tmp$/;
    my @st = lstat("$dir/$n") or next;
    next unless -f _ && $st[4] == $< && time - $st[9] > 3600;
    unlink "$dir/$n";
  }
  closedir $dh;
}

# A random name rather than the pid: a pid comes round again, and a name that
# can be guessed can be waited for.
my $fh;
for my $try (1 .. 16) {
  open(my $r, '<', '/dev/urandom') or exit 1;
  read($r, my $rnd, 8) == 8 or exit 1;
  close $r;
  my $name = sprintf('%s/.history.%s.tmp', $dir, unpack('H*', $rnd));
  if (sysopen($fh, $name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600)) { $tmp = $name; last }
  undef $fh;
}
exit 1 unless $fh;

binmode $fh;
my $off = 0;
while ($off < length $doc) {
  my $n = syswrite($fh, $doc, length($doc) - $off, $off);
  if (!defined $n) { next if $! == EINTR; exit 1 }
  $off += $n;
}
# On the disk before the name points at it, so a power cut leaves the old store
# rather than a new one full of holes. A failed fsync is a failed write.
defined($fh->sync) or exit 1;
close($fh) or exit 1;

rename($tmp, $path) or exit 1;
undef $tmp;                               # renamed: nothing left to remove

# The rename is a write of its own, to the folder. Until that is on the disk
# too, a power cut can bring back the old name, or none.
if (sysopen(my $dfh, $dir, O_RDONLY | O_DIRECTORY)) { $dfh->sync; close $dfh }
exit 0;
PERL
}

# Sourced rather than run (the tests do, to reach one function at a time): define
# everything above and do nothing.
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

case "${1:-top}" in
  stream)  shift; stream "$@" ;;
  top)     shift; top "$@" ;;
  validate) shift; validate "$@" ;;
  explain) shift; explain "$@" ;;
  history) history_read ;;
  save)    history_write ;;
  probe)   probe ;;
  doctor)  doctor ;;
  -V|--version) printf 'net-usage %s\n' "$VERSION" ;;
  -h|--help)
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "unknown command '${1}' — try: top, stream, validate, explain, history, probe, doctor" ;;
esac
